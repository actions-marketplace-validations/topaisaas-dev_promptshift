# ==============================================================================
# PromptShift (promptshift.dev) — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Fill in the keys you wish to use.
# 2. Supports Direct IBAN payouts (Mollie, Lemon Squeezy), PayPal, or Stripe.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GENERAL APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="PromptShift"
NEXT_PUBLIC_APP_URL="https://promptshift.dev"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. PAYMENT GATEWAY: DIRECT IBAN PAYOUT (Mollie / Lemon Squeezy / Payplug)
# ------------------------------------------------------------------------------
# Customers pay with Credit Card (Visa, Mastercard, CB, Apple Pay).
# Payouts are sent directly to your IBAN (no Stripe, no PayPal required).
MOLLIE_API_KEY="live_..."

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAY: PAYPAL (Alternative)
# ------------------------------------------------------------------------------
PAYPAL_MODE="sandbox" # "sandbox" or "live"
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret"
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY: STRIPE (Alternative)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE EDGE HOSTING & STORAGE
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token"
R2_BUCKET_NAME="promptshift-ephemeral-uploads"

# ------------------------------------------------------------------------------
# 6. DATABASE & AUTHENTICATION (Supabase — Free tier)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# ------------------------------------------------------------------------------
# 7. OPTIONAL AI ENHANCEMENTS (Google Gemini API)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSy..."

# ------------------------------------------------------------------------------
# 8. ADMIN COMMAND CENTER & ANALYTICS PASSKEY
# ------------------------------------------------------------------------------
PROMPTSHIFT_ADMIN_KEY="your_secure_admin_passkey_here"

